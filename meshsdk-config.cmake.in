@PACKAGE_INIT@

set(MR_EMSCRIPTEN "@MR_EMSCRIPTEN@")
if(MR_EMSCRIPTEN)
  set(MESHSDK_INCLUDE_DIR "@PACKAGE_MR_INCLUDE_DIR@")
  set(MESHSDK_THIRDPARTY_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@;@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/imgui")
  set(MESHSDK_THIRDPARTY_LIB_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
  set(MESHSDK_EMSCRIPTEN_CXX_FLAGS "@MESHSDK_EMSCRIPTEN_CXX_FLAGS@")
  set(MESHSDK_EMSCRIPTEN_EXE_LINKER_FLAGS "@MESHSDK_EMSCRIPTEN_EXE_LINKER_FLAGS@")
else(MR_EMSCRIPTEN)
  set(MESHSDK_INCLUDE_DIR "@PACKAGE_MR_INCLUDE_DIR@")
  set(MESHSDK_THIRDPARTY_INCLUDE_DIR "@PACKAGE_MR_INCLUDE_DIR@/include;@PACKAGE_MR_INCLUDE_DIR@/include/imgui")
  set(MESHSDK_THIRDPARTY_LIB_DIR "@PACKAGE_MR_MAIN_LIB_DIR@/lib")
endif(MR_EMSCRIPTEN)

get_filename_component(SELF_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)

set(MESHSDK_BUILD_MRVIEWER @MESHSDK_BUILD_MRVIEWER@)
set(MESHSDK_BUILD_MRCUDA @MESHSDK_BUILD_MRCUDA@)
set(MESHSDK_EXPERIMENTAL_BUILD_C_BINDING @MESHSDK_EXPERIMENTAL_BUILD_C_BINDING@)
set(MESHSDK_BUILD_GENERATED_C_BINDINGS @MESHSDK_BUILD_GENERATED_C_BINDINGS@)
set(MESHSDK_BUILD_SYMBOLMESH @MESHSDK_BUILD_SYMBOLMESH@)
set(MESHSDK_BUILD_VOXELS @MESHSDK_BUILD_VOXELS@)
set(MESHSDK_BUILD_EXTRA_IO_FORMATS @MESHSDK_BUILD_EXTRA_IO_FORMATS@)

include(${SELF_DIR}/MRMeshConfig.cmake)
if(MESHSDK_BUILD_EXTRA_IO_FORMATS)
    include(${SELF_DIR}/MRIOExtrasConfig.cmake)
endif(MESHSDK_BUILD_EXTRA_IO_FORMATS)
if(MESHSDK_BUILD_SYMBOLMESH)
    include(${SELF_DIR}/MRSymbolMeshConfig.cmake)
endif(MESHSDK_BUILD_SYMBOLMESH)
if(MESHSDK_BUILD_VOXELS)
    include(${SELF_DIR}/MRVoxelsConfig.cmake)
endif(MESHSDK_BUILD_VOXELS)
if(MESHSDK_BUILD_MRCUDA)
    include(${SELF_DIR}/MRCudaConfig.cmake)
endif(MESHSDK_BUILD_MRCUDA)
if(MESHSDK_EXPERIMENTAL_BUILD_C_BINDING)
    include(${SELF_DIR}/MRMeshCConfig.cmake)
endif(MESHSDK_EXPERIMENTAL_BUILD_C_BINDING)
if(MESHSDK_BUILD_GENERATED_C_BINDINGS)
    include(${SELF_DIR}/MeshSDKC2Config.cmake)
endif(MESHSDK_BUILD_GENERATED_C_BINDINGS)
if(MESHSDK_BUILD_MRVIEWER)
    include(${SELF_DIR}/imguiConfig.cmake)
    include(${SELF_DIR}/MRViewerConfig.cmake)
    include(${SELF_DIR}/MRCommonPluginsConfig.cmake)
endif(MESHSDK_BUILD_MRVIEWER)

if(APPLE)
    message("You can install required packages via brew: ' xargs brew install < /Library/Frameworks/MeshSDK.framework/Versions/Current/requirements/macos.txt '")
endif(APPLE)

if(EMSCRIPTEN)
    include(${SELF_DIR}/EmscriptenHelpers.cmake)
endif(EMSCRIPTEN)
